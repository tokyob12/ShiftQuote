[Unit]
Description=Shift signed off-chain Route Quote order book
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/shift-keeper/keeper
Environment=PATH=/home/ubuntu/.local/bin:/usr/bin
EnvironmentFile=/etc/shift/route-book.env
ExecStart=/home/ubuntu/.local/bin/npm run --silent route-book
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
