pragma solidity 0.8.28;
import {Test} from "forge-std/Test.sol";
import {SignedPosition} from "../src/SignedPosition.sol";
import {PositionV2} from "../src/PositionV2.sol";
import {DemoAsset} from "../src/DemoAsset.sol";
import {MockUsdc} from "../src/MockUsdc.sol";
contract SignedPositionTest is Test {
    SignedPosition desk;DemoAsset base;MockUsdc usdc;uint256 key=12345;address buyer=address(0xB0B);uint256 sequence;
    function quote(uint8 action,address caller,uint256 size,uint256 mid) internal returns(SignedPosition.Quote memory q,bytes memory sig){q=SignedPosition.Quote(action,caller,size,mid,mid,10,1,uint64(block.timestamp),uint64(block.timestamp+15),desk.signerEpoch(),bytes32(++sequence));(uint8 v,bytes32 r,bytes32 s)=vm.sign(key,desk.quoteDigest(q));sig=abi.encodePacked(r,s,v);}
    function setUp() public {vm.warp(100000);base=new DemoAsset(address(this));usdc=new MockUsdc(address(this));desk=new SignedPosition(address(this),address(base),address(usdc),vm.addr(key));base.mint(address(this),100e18);base.approve(address(desk),type(uint256).max);usdc.mint(buyer,1000e6);vm.prank(buyer);usdc.approve(address(desk),type(uint256).max);(SignedPosition.Quote memory q,bytes memory sig)=quote(2,address(this),100e18,80e18);desk.depositSigned(100e18,0,q,sig);desk.setSwapsOpen(true);}
    function testSignedSwapNeedsNoPostedSnapshot() public {(SignedPosition.Quote memory q,bytes memory sig)=quote(1,buyer,1e18,80e18);vm.prank(buyer);desk.swapSigned(1e18,80e6,q,sig);assertEq(base.balanceOf(buyer),1e18);assertEq(desk.elysiumQuote(),80e6);}
    function testQuoteCannotReplay() public {(SignedPosition.Quote memory q,bytes memory sig)=quote(1,buyer,1e18,80e18);vm.prank(buyer);desk.swapSigned(1e18,80e6,q,sig);vm.prank(buyer);vm.expectRevert(SignedPosition.InvalidSignedQuote.selector);desk.swapSigned(1e18,80e6,q,sig);}
    function testQuoteBindsCallerSizeAndAction() public {(SignedPosition.Quote memory q,bytes memory sig)=quote(1,buyer,1e18,80e18);vm.expectRevert(SignedPosition.InvalidSignedQuote.selector);desk.swapSigned(1e18,80e6,q,sig);vm.prank(buyer);vm.expectRevert(SignedPosition.InvalidSignedQuote.selector);desk.swapSigned(2e18,160e6,q,sig);q.action=3;vm.prank(buyer);vm.expectRevert(SignedPosition.InvalidSignedQuote.selector);desk.swapSigned(1e18,80e6,q,sig);}
    function testQuoteExpiresAndEpochInvalidates() public {(SignedPosition.Quote memory q,bytes memory sig)=quote(1,buyer,1e18,80e18);desk.invalidateSignedQuotes();vm.prank(buyer);vm.expectRevert(SignedPosition.InvalidSignedQuote.selector);desk.swapSigned(1e18,80e6,q,sig);(q,sig)=quote(1,buyer,1e18,80e18);vm.warp(block.timestamp+16);vm.prank(buyer);vm.expectRevert(SignedPosition.InvalidSignedQuote.selector);desk.swapSigned(1e18,80e6,q,sig);}
    function testChangedContractOrPriceInvalidatesSignature() public {(SignedPosition.Quote memory q,bytes memory sig)=quote(1,buyer,1e18,80e18);q.askX18=81e18;vm.prank(buyer);vm.expectRevert(SignedPosition.InvalidSignedQuote.selector);desk.swapSigned(1e18,81e6,q,sig);SignedPosition other=new SignedPosition(address(this),address(base),address(usdc),vm.addr(key));q.askX18=80e18;vm.prank(buyer);vm.expectRevert(SignedPosition.InvalidSignedQuote.selector);other.swapSigned(1e18,80e6,q,sig);}
    function testPullAndScriptedShiftStillWork() public {(SignedPosition.Quote memory q,bytes memory sig)=quote(3,address(this),100e18,81e18);assertEq(uint256(desk.evaluateSigned(q,sig)),uint256(PositionV2.Decision.Pull));(q,sig)=quote(4,address(this),100e18,81e18);desk.requoteSigned(q,sig);desk.setSpotLinked(true);(q,sig)=quote(5,address(this),100e18,81e18);desk.shiftSigned(q,sig);assertEq(desk.transitBase(),25e18);desk.advanceScripted();desk.advanceScripted();desk.returnScripted();assertEq(desk.elysiumBase(),100e18);}
    function testUnsignedLegacyEntrypointsRejected() public {vm.expectRevert(SignedPosition.SignedQuoteRequired.selector);desk.swap(1e18,80e6);vm.expectRevert(SignedPosition.SignedQuoteRequired.selector);desk.evaluate();}
    function testOutsideBandStillRejectsSwap() public {(SignedPosition.Quote memory q,bytes memory sig)=quote(1,buyer,1e18,81e18);vm.prank(buyer);vm.expectRevert(PositionV2.OutsideBand.selector);desk.swapSigned(1e18,81e6,q,sig);assertFalse(desk.usedQuotes(desk.quoteDigest(q)));}
}
